# Google Form Configuration
FORM_LINK=https://docs.google.com/forms/d/your_form_id/viewform

# Whitelist Submission Details (comma-separated for multiple entries)
WALLET_ADDRESS=0x1234567890abcdef1234567890abcdef12345678,0xabcdef1234567890abcdef1234567890abcdef12
X_USERNAME=your_twitter_handle,another_handle
X_LINK=https://twitter.com/your_profile,https://twitter.com/another_profile

# Google Account Login (optional - required for forms that need sign-in)
# Option 1: Use GMAIL_ALIAS - email+alias1, email+alias2, etc (recommended)
# Option 2: Use multiple emails - email1@gmail.com,email2@gmail.com
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_PASSWORD=your_app_password

# Gmail Alias Strategy - Bypasses "one email per response" restriction
# If using Gmail, set this to create unique emails: email+1@, email+2@, email+3@, etc
# Example: your_email@gmail.com with GMAIL_ALIAS_PREFIX=whitelist creates:
#   your_email+whitelist1@gmail.com, your_email+whitelist2@gmail.com, etc
# Leave empty to use exact email without aliases
GMAIL_ALIAS_PREFIX=whitelist

# Wait Times (in seconds) - Lower = faster, Higher = more stable
# Adjust based on form load time and your internet speed
ELEMENT_WAIT_TIMEOUT=5
FORM_LOAD_WAIT=1
SUBMIT_WAIT=1
BETWEEN_SUBMISSIONS=0.5

# Number of responses to submit (leave empty to auto-use number of entries)
NUM_RESPONSES=

# Firefox Driver Path (leave empty to use system PATH)
DRIVER_PATH=

# Template folder for Flask (optional)
TEMPLATE_FOLDER=./templates
